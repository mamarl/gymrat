{
  "expo": {
    "name": "gymrat",
    "slug": "gymrat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gymraticonremove.png",
    "scheme": "gymrat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/gymraticonremove.png"
    },
   "android": {
  "icon": "./assets/images/gymraticonremove.png",
  "predictiveBackGestureEnabled": false,
  "package": "com.spoodermarl.gymrat"
},
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f779d5c6-9ccf-4f90-8b75-e7965a5d6dea"
      }
    }
  }
}
